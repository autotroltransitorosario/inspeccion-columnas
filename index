<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Inspección de Columnas · AUTOTROL</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<style>
:root{
  --navy-950:#0A1628;
  --navy-900:#0D1F3C;
  --navy-800:#162B52;
  --navy-700:#1E3A6E;
  --orange:#E87D2B;
  --orange-d:#C9651A;
  --steel:#5c6b85;
  --bg:#EDF1F7;
  --card:#ffffff;
  --border:#D1DAEA;
  --border-soft:#E8EDF5;
  --text:#0D1F3C;
  --text-muted:#6A7F99;
  --yes:#059669;
  --yes-bg:#D1FAE5;
  --yes-text:#064E3B;
  --no:#DC2626;
  --no-bg:#FEE2E2;
  --no-text:#7F1D1D;
  --mono:'JetBrains Mono','SFMono-Regular',Consolas,'Liberation Mono',Menlo,monospace;
  --sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --cond:'Barlow Condensed','Arial Narrow',Arial,sans-serif;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{font-family:var(--sans);background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;}

/* ── Topbar ── */
.topbar{
  background:linear-gradient(180deg,var(--navy-900),var(--navy-950));
  color:#fff;padding:0 28px;height:64px;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  border-bottom:3px solid var(--orange);
  position:sticky;top:0;z-index:40;
}
.brand{display:flex;align-items:center;gap:14px;}
.brand-logo-wrap{
  background:#fff;border-radius:7px;padding:5px 10px;
  display:flex;align-items:center;
  box-shadow:0 1px 3px rgba(0,0,0,.25);
}
.brand-logo{height:24px;width:auto;display:block;}
.brand-text{padding-left:14px;border-left:1px solid rgba(255,255,255,.18);}
.brand-text h1{margin:0;font-family:var(--cond);font-size:17px;letter-spacing:.8px;font-weight:700;text-transform:uppercase;}
.brand-text p{margin:2px 0 0;font-size:11px;color:rgba(255,255,255,.5);letter-spacing:.2px;}
.topbar-right{display:flex;align-items:center;gap:10px;}
.pill{
  font-family:var(--mono);font-size:11.5px;
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.13);
  padding:5px 12px;border-radius:20px;color:#e7ecf5;white-space:nowrap;
}
.pill.ok{border-color:rgba(90,180,130,.4);color:#a7f3d0;}
.pill.err{border-color:rgba(217,101,89,.5);color:#fca5a5;}
.pill.loading{animation:pulse 1.4s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}

/* ── Controls ── */
.controls{
  max-width:1540px;margin:20px auto 0;padding:0 28px;
  display:flex;gap:10px;flex-wrap:wrap;align-items:center;
}
.search-wrap{flex:1 1 300px;position:relative;}
.search-wrap input{
  width:100%;padding:10px 13px 10px 38px;border:1px solid var(--border);
  border-radius:9px;background:var(--card);font-size:13.5px;color:var(--text);
  font-family:var(--sans);outline:none;
}
.search-wrap input:focus{outline:2px solid var(--orange);outline-offset:-1px;}
.search-wrap svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.4;pointer-events:none;}
select.fsel{
  padding:10px 12px;border:1px solid var(--border);border-radius:9px;
  background:var(--card);font-size:13px;color:var(--text);font-family:var(--sans);
  min-width:160px;outline:none;cursor:pointer;
}
select.fsel:focus{outline:2px solid var(--orange);outline-offset:-1px;}
.btn-reload{
  background:var(--navy-900);color:#fff;border:none;
  padding:10px 16px;border-radius:9px;font-size:13px;font-weight:600;cursor:pointer;
  font-family:var(--sans);display:inline-flex;align-items:center;gap:7px;white-space:nowrap;
}
.btn-reload:hover{background:var(--navy-800);}
.legend{
  display:flex;gap:12px;align-items:center;font-size:12px;color:var(--text-muted);
  margin-left:auto;
}
.legend span{display:flex;align-items:center;gap:5px;}
.dot{width:8px;height:8px;border-radius:50%;display:inline-block;}
.dot.si{background:var(--yes);}
.dot.no{background:var(--no);}

/* ── Table card ── */
.table-card{max-width:1540px;margin:14px auto 40px;padding:0 28px;}
.table-scroll{
  background:var(--card);border:1px solid var(--border);border-radius:12px;
  overflow:auto;box-shadow:0 1px 2px rgba(13,31,60,.04),0 8px 24px -12px rgba(13,31,60,.1);
}
table{border-collapse:collapse;width:100%;min-width:1400px;font-size:13px;}
thead th{
  position:sticky;top:0;background:var(--navy-950);color:#dfe4ee;
  text-align:left;padding:12px 14px;font-weight:600;font-size:11px;
  letter-spacing:.5px;text-transform:uppercase;border-bottom:1px solid #000;
  white-space:nowrap;font-family:var(--cond);
}
thead th.center{text-align:center;}
tbody td{
  padding:10px 14px;border-bottom:1px solid var(--border-soft);vertical-align:middle;
  color:var(--text);white-space:nowrap;
}
tbody tr:hover{background:#f5f8fc;}
tbody tr:nth-child(even){background:#fbfcfe;}
tbody tr:nth-child(even):hover{background:#f2f6fb;}

/* Cells */
.num-badge{
  font-family:var(--mono);font-weight:700;font-size:13px;
  background:var(--navy-900);color:#ffd28a;
  padding:4px 9px;border-radius:6px;letter-spacing:.3px;
}
.cell-muted{color:#b6bac5;}
.calle-cell{white-space:normal;max-width:180px;}
.calle-name{font-weight:600;}
.piq-code{font-family:var(--mono);font-size:12px;color:var(--text-muted);}
.chip{
  font-size:11px;padding:3px 9px;border-radius:20px;font-weight:700;
  border:1px solid transparent;letter-spacing:.3px;
}
.chip.si{background:var(--yes-bg);color:var(--yes-text);border-color:#a7f3d0;}
.chip.no{background:var(--no-bg);color:var(--no-text);border-color:#fca5a5;}
.chip.na{background:#f0f1f4;color:#9aa0af;border-color:#e5e6ea;}
.accion-pill{
  font-size:11.5px;font-weight:600;padding:3px 10px;border-radius:6px;
  background:rgba(232,125,43,.12);color:var(--orange-d);
  border:1px solid rgba(232,125,43,.25);font-family:var(--sans);white-space:nowrap;
}
.obs-cell{max-width:200px;white-space:normal;font-size:12px;color:var(--text-muted);line-height:1.4;}

/* Thumbnails */
.thumb{
  width:44px;height:44px;border-radius:7px;object-fit:cover;
  border:1px solid var(--border);cursor:pointer;display:block;
  background:#f1f3f7;transition:transform .12s ease;
}
.thumb:hover{transform:scale(1.08);border-color:var(--orange);}
.thumb-empty{
  width:44px;height:44px;border-radius:7px;border:1px dashed var(--border);
  display:flex;align-items:center;justify-content:center;
  color:#c1c5cf;font-size:16px;background:#f7f8fa;
}

/* ── Pagination ── */
.pagination{
  display:flex;align-items:center;justify-content:center;gap:14px;
  padding:16px 0 4px;font-size:13px;color:var(--text-muted);
}
.pagination button{
  background:var(--card);border:1px solid var(--border);border-radius:7px;
  padding:7px 16px;font-size:12.5px;cursor:pointer;color:var(--text);
  font-family:var(--sans);
}
.pagination button:disabled{opacity:.35;cursor:not-allowed;}
.pagination button:not(:disabled):hover{border-color:var(--orange);}

.empty-state{text-align:center;padding:50px 20px;color:var(--text-muted);font-size:14px;}

/* ── Lightbox ── */
.lightbox{
  position:fixed;inset:0;background:rgba(8,13,24,.88);
  display:none;align-items:center;justify-content:center;z-index:100;
  padding:40px;backdrop-filter:blur(3px);
}
.lightbox.open{display:flex;}
.lightbox-inner{
  max-width:min(90vw,900px);max-height:88vh;
  display:flex;flex-direction:column;align-items:center;gap:12px;
}
.lightbox-inner img{
  max-width:100%;max-height:76vh;border-radius:10px;
  border:1px solid rgba(255,255,255,.12);
  box-shadow:0 20px 60px rgba(0,0,0,.6);background:#fff;
}
.lightbox-caption{color:#e7ecf5;font-size:13px;text-align:center;}
.lightbox-caption b{color:#fff;}
.lightbox-close{
  position:absolute;top:20px;right:24px;color:#fff;
  background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);
  width:38px;height:38px;border-radius:50%;font-size:18px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
}
.lightbox-close:hover{background:rgba(255,255,255,.2);}
.lightbox-nav{
  position:absolute;top:50%;transform:translateY(-50%);
  background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);color:#fff;
  width:42px;height:42px;border-radius:50%;font-size:18px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
}
.lightbox-nav:hover{background:rgba(255,255,255,.2);}
.lightbox-nav.prev{left:20px;}
.lightbox-nav.next{right:20px;}
.lightbox-nav:disabled{opacity:.2;cursor:not-allowed;}

/* ── Toast ── */
.toast{
  position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(12px);
  background:var(--navy-950);color:#fff;padding:11px 20px;border-radius:9px;
  font-size:13px;opacity:0;pointer-events:none;transition:all .25s ease;z-index:200;
  border:1px solid rgba(255,255,255,.1);box-shadow:0 10px 30px rgba(0,0,0,.3);white-space:nowrap;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* ── Footer ── */
.app-footer{
  max-width:1540px;margin:0 auto 20px;padding:14px 28px;
  display:flex;align-items:center;justify-content:space-between;
  font-size:12px;color:var(--text-muted);
  border-top:1px solid var(--border);
}

@media(max-width:720px){
  .topbar{padding:0 14px;}
  .controls,.table-card{padding:0 14px;}
  .legend{display:none;}
}
</style>
</head>
<body>

<!-- ══ TOPBAR ══ -->
<div class="topbar">
  <div class="brand">
    <div class="brand-logo-wrap">
      <img class="brand-logo" src="data:image/png;base64," alt="AUTOTROL">
    </div>
    <div class="brand-text">
      <h1>Inspección de Columnas</h1>
      <p>Riesgo y Mitigación · Verificación Mecánica y Eléctrica</p>
    </div>
  </div>
  <div class="topbar-right">
    <span id="syncStatus" class="pill loading">⏳ Cargando…</span>
    <span id="totalLabel" class="pill">—</span>
  </div>
</div>

<!-- ══ CONTROLS ══ -->
<div class="controls">
  <div class="search-wrap">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
    <input type="text" id="searchInput" placeholder="Buscar por calle, piquete, observaciones…">
  </div>
  <select class="fsel" id="accionFilter">
    <option value="">Acción (todas)</option>
    <option value="Oxido en Base">Óxido en Base</option>
    <option value="Reparacion">Reparación</option>
    <option value="Pintura">Pintura</option>
    <option value="Limpieza">Limpieza</option>
  </select>
  <select class="fsel" id="oxidoFilter">
    <option value="">Óxido en Base (todos)</option>
    <option value="SI">SI</option>
    <option value="NO">NO</option>
  </select>
  <button class="btn-reload" onclick="loadData()">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4"/></svg>
    Actualizar
  </button>
  <div class="legend">
    <span><i class="dot si"></i> SI</span>
    <span><i class="dot no"></i> NO</span>
  </div>
</div>

<!-- ══ TABLE ══ -->
<div class="table-card">
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Nº</th>
          <th>Calle</th>
          <th>Altura</th>
          <th>Piquete</th>
          <th class="center">Óxido</th>
          <th class="center">Aplomada</th>
          <th class="center">T. Ventana</th>
          <th class="center">B. Perforada</th>
          <th class="center">Pintura</th>
          <th class="center">PAT</th>
          <th class="center">ID</th>
          <th>Acción</th>
          <th>Foto Estado</th>
          <th>Foto Reparación</th>
          <th>Ultima Inspección</th>
          <th>Observaciones</th>
        </tr>
      </thead>
      <tbody id="tbody">
        <tr><td colspan="16" class="empty-state">⏳ Cargando datos…</td></tr>
      </tbody>
    </table>
    <div class="empty-state" id="emptyState" style="display:none">🔍 Sin resultados para los filtros aplicados</div>
  </div>
  <div class="pagination">
    <button id="prevBtn" disabled>← Anterior</button>
    <span id="pageLabel">Página 1 de 1</span>
    <button id="nextBtn" disabled>Siguiente →</button>
  </div>
</div>

<!-- ══ FOOTER ══ -->
<footer class="app-footer">
  <span>Desarrollado por <strong>Martin Cipriani</strong> &nbsp;·&nbsp; <span style="font-family:var(--mono);font-size:11px;opacity:.6">v 1.0.0</span></span>
  <span id="footerLabel" style="font-family:var(--mono);font-size:11px;"></span>
</footer>

<!-- ══ LIGHTBOX ══ -->
<div class="lightbox" id="lightbox" onclick="closeLightbox(event)">
  <button class="lightbox-nav prev" id="lbPrev" onclick="lbNav(-1)">&#8249;</button>
  <div class="lightbox-inner">
    <img id="lbImg" src="" alt="">
    <div class="lightbox-caption" id="lbCaption"></div>
  </div>
  <button class="lightbox-nav next" id="lbNext" onclick="lbNav(1)">&#8250;</button>
  <button class="lightbox-close" onclick="closeLightbox()">✕</button>
</div>

<!-- ══ TOAST ══ -->
<div class="toast" id="toast"></div>

<script>
// ── Config ──────────────────────────────────────────────────
const SHEET_ID  = '1IRfCwKpKpFoWgPEI36B5nNgN5EOc7ixgmMlVEFbqJLQ';
const SHEET_GID = '1331561464';
const CSV_URL   = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/export?format=csv&gid=${SHEET_GID}`;
const PAGE_SIZE = 50;

// ── State ───────────────────────────────────────────────────
let allData  = [];
let filtered = [];
let page     = 1;
let lbImages = [];
let lbIndex  = 0;

// ── Drive helpers ────────────────────────────────────────────
function driveThumb(url) {
  if (!url || !url.trim()) return null;
  let m = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
  if (!m) m = url.match(/id=([a-zA-Z0-9_-]+)/);
  if (!m) return null;
  return `https://drive.google.com/thumbnail?id=${m[1]}&sz=w200-h150`;
}
function driveView(url) {
  if (!url || !url.trim()) return null;
  let m = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
  if (!m) m = url.match(/id=([a-zA-Z0-9_-]+)/);
  if (!m) return null;
  return `https://drive.google.com/uc?id=${m[1]}&export=view`;
}

// ── Load CSV ─────────────────────────────────────────────────
function loadData() {
  document.getElementById('syncStatus').className = 'pill loading';
  document.getElementById('syncStatus').textContent = '⏳ Cargando…';

  Papa.parse(CSV_URL + '&t=' + Date.now(), {
    download: true,
    header: true,
    skipEmptyLines: true,
    complete(results) {
      allData = results.data.map(parseRow).filter(r => r.cantidad);
      populateAccionFilter();
      applyFilters();
      const el = document.getElementById('syncStatus');
      el.className = 'pill ok';
      el.textContent = '✅ Actualizado';
      setTimeout(() => { el.textContent = '● En línea'; }, 2500);
    },
    error(err) {
      const el = document.getElementById('syncStatus');
      el.className = 'pill err';
      el.textContent = '⚠ Error al cargar';
      toast('Error: ' + err.message, 'err');
    }
  });
}

function parseRow(r) {
  // Mapeo de columnas según appendRow del Code.gs
  // A=Cantidad, B=ORDEN, C=Calle, D=Altura, E=Piquete,
  // F=Lat, G=Lon, H=OxidoEnBase, I=Aplomada, J=TapaVentana,
  // K=BasePerforada, L=Pintura, M=PAT, N=ID,
  // O=FotoEstado, P=Accion, Q=FotoReparacion,
  // R=UltimaInspeccion, S=Observaciones
  const keys = Object.keys(r);
  const get = i => (r[keys[i]] || '').trim();
  return {
    cantidad:       get(0),
    orden:          get(1),
    calle:          get(2),
    altura:         get(3),
    piquete:        get(4),
    lat:            get(5),
    lon:            get(6),
    oxidoEnBase:    get(7).toUpperCase(),
    aplomada:       get(8).toUpperCase(),
    tapaVentana:    get(9).toUpperCase(),
    basePerforada:  get(10).toUpperCase(),
    pintura:        get(11).toUpperCase(),
    pat:            get(12).toUpperCase(),
    id:             get(13).toUpperCase(),
    fotoEstadoUrl:  get(14),
    accion:         get(15),
    fotoRepUrl:     get(16),
    ultimaInspeccion: get(17),
    observaciones:  get(18),
  };
}

// ── Populate dynamic filter ───────────────────────────────────
function populateAccionFilter() {
  const sel = document.getElementById('accionFilter');
  const current = sel.value;
  const vals = [...new Set(allData.map(r => r.accion).filter(Boolean))].sort();
  sel.innerHTML = '<option value="">Acción (todas)</option>';
  vals.forEach(v => {
    const o = document.createElement('option');
    o.value = v; o.textContent = v; sel.appendChild(o);
  });
  if (vals.includes(current)) sel.value = current;
}

// ── Filters ──────────────────────────────────────────────────
function applyFilters() {
  const q      = document.getElementById('searchInput').value.trim().toLowerCase();
  const accion = document.getElementById('accionFilter').value;
  const oxido  = document.getElementById('oxidoFilter').value;

  filtered = allData.filter(r => {
    if (accion && r.accion !== accion) return false;
    if (oxido  && r.oxidoEnBase !== oxido) return false;
    if (q) {
      const hay = [r.calle, r.altura, r.piquete, r.observaciones, r.accion, r.cantidad]
        .map(x => String(x || '').toLowerCase()).join(' ');
      if (!hay.includes(q)) return false;
    }
    return true;
  });
  page = 1;
  render();
}

// ── Render ───────────────────────────────────────────────────
function render() {
  const tbody = document.getElementById('tbody');
  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
  const start = (page - 1) * PAGE_SIZE;
  const items = filtered.slice(start, start + PAGE_SIZE);

  document.getElementById('totalLabel').textContent =
    `${filtered.length} de ${allData.length} registros`;
  document.getElementById('pageLabel').textContent =
    `Página ${page} de ${totalPages}`;
  document.getElementById('footerLabel').textContent =
    `${filtered.length} registros · Pág ${page}/${totalPages}`;
  document.getElementById('prevBtn').disabled = page <= 1;
  document.getElementById('nextBtn').disabled = page >= totalPages;

  if (items.length === 0) {
    tbody.innerHTML = '';
    document.getElementById('emptyState').style.display = 'block';
  } else {
    document.getElementById('emptyState').style.display = 'none';
    tbody.innerHTML = items.map(rowHtml).join('');
  }
}

// ── Chip ─────────────────────────────────────────────────────
function chip(v) {
  if (!v) return '<span class="chip na">—</span>';
  const s = v.toUpperCase();
  if (s === 'SI' || s === 'SÍ') return '<span class="chip si">SI</span>';
  if (s === 'NO') return '<span class="chip no">NO</span>';
  return `<span class="chip na">${esc(v)}</span>`;
}
function esc(s) {
  return String(s || '').replace(/[&<>"']/g,
    c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function dash(v) {
  return v ? esc(v) : '<span class="cell-muted">—</span>';
}

// ── Thumbnail ────────────────────────────────────────────────
function thumbCell(url, label, idx, imgKey) {
  const thumb = driveThumb(url);
  const full  = driveView(url);
  if (!thumb) return '<div class="thumb-empty">—</div>';
  return `<img class="thumb" loading="lazy"
    src="${esc(thumb)}"
    alt="${esc(label)}"
    onerror="this.outerHTML='<div class=\\'thumb-empty\\'>⚠</div>'"
    onclick="openLb(${idx},'${imgKey}')">`;
}

// Build lightbox images list per row index
const rowImages = {}; // idx -> { estado: url, rep: url }

function rowHtml(r, localIdx) {
  const globalIdx = (page - 1) * PAGE_SIZE + localIdx;
  rowImages[globalIdx] = { estado: driveView(r.fotoEstadoUrl), rep: driveView(r.fotoRepUrl) };

  const accionCell = r.accion
    ? `<span class="accion-pill">${esc(r.accion)}</span>`
    : '<span class="cell-muted">—</span>';
  const obsCell = r.observaciones
    ? `<span class="obs-cell">${esc(r.observaciones)}</span>`
    : '<span class="cell-muted">—</span>';

  return `<tr>
    <td><span class="num-badge">${esc(String(r.cantidad).padStart(4,'0'))}</span></td>
    <td class="calle-cell"><span class="calle-name">${esc(r.calle)||'—'}</span></td>
    <td>${dash(r.altura)}</td>
    <td><span class="piq-code">${dash(r.piquete)}</span></td>
    <td style="text-align:center">${chip(r.oxidoEnBase)}</td>
    <td style="text-align:center">${chip(r.aplomada)}</td>
    <td style="text-align:center">${chip(r.tapaVentana)}</td>
    <td style="text-align:center">${chip(r.basePerforada)}</td>
    <td style="text-align:center">${chip(r.pintura)}</td>
    <td style="text-align:center">${chip(r.pat)}</td>
    <td style="text-align:center">${chip(r.id)}</td>
    <td>${accionCell}</td>
    <td>${thumbCell(r.fotoEstadoUrl, 'Foto Estado', globalIdx, 'estado')}</td>
    <td>${thumbCell(r.fotoRepUrl, 'Foto Reparación', globalIdx, 'rep')}</td>
    <td>${dash(r.ultimaInspeccion)}</td>
    <td>${obsCell}</td>
  </tr>`;
}

// Override to pass localIdx correctly
function render() {
  const tbody = document.getElementById('tbody');
  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
  const start = (page - 1) * PAGE_SIZE;
  const items = filtered.slice(start, start + PAGE_SIZE);

  document.getElementById('totalLabel').textContent =
    `${filtered.length} de ${allData.length} registros`;
  document.getElementById('pageLabel').textContent =
    `Página ${page} de ${totalPages}`;
  document.getElementById('footerLabel').textContent =
    `${filtered.length} registros · Pág ${page}/${totalPages}`;
  document.getElementById('prevBtn').disabled = page <= 1;
  document.getElementById('nextBtn').disabled = page >= totalPages;

  if (items.length === 0) {
    tbody.innerHTML = '';
    document.getElementById('emptyState').style.display = 'block';
  } else {
    document.getElementById('emptyState').style.display = 'none';
    tbody.innerHTML = items.map((r, i) => rowHtml(r, i)).join('');
  }
}

// ── Lightbox ──────────────────────────────────────────────────
function openLb(globalIdx, imgKey) {
  const imgs = rowImages[globalIdx];
  if (!imgs) return;
  lbImages = [];
  if (imgs.estado) lbImages.push({ url: imgs.estado, label: 'Foto Estado' });
  if (imgs.rep)    lbImages.push({ url: imgs.rep,    label: 'Foto Reparación' });
  lbIndex = imgKey === 'rep' && imgs.estado ? 1 : 0;
  if (!lbImages.length) return;
  showLb();
}
function showLb() {
  const img = lbImages[lbIndex];
  document.getElementById('lbImg').src = img.url;
  document.getElementById('lbCaption').innerHTML = `<b>${esc(img.label)}</b> &nbsp;${lbIndex+1} / ${lbImages.length}`;
  document.getElementById('lbPrev').disabled = lbIndex <= 0;
  document.getElementById('lbNext').disabled = lbIndex >= lbImages.length - 1;
  document.getElementById('lightbox').classList.add('open');
}
function lbNav(dir) {
  lbIndex = Math.max(0, Math.min(lbImages.length - 1, lbIndex + dir));
  showLb();
}
function closeLightbox(e) {
  if (!e || e.target === document.getElementById('lightbox') || e.currentTarget.classList.contains('lightbox-close')) {
    document.getElementById('lightbox').classList.remove('open');
    document.getElementById('lbImg').src = '';
  }
}
document.addEventListener('keydown', e => {
  if (!document.getElementById('lightbox').classList.contains('open')) return;
  if (e.key === 'ArrowLeft')  lbNav(-1);
  if (e.key === 'ArrowRight') lbNav(1);
  if (e.key === 'Escape')     closeLightbox();
});

// ── Events ────────────────────────────────────────────────────
let searchTimer;
document.getElementById('searchInput').addEventListener('input', () => {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(applyFilters, 200);
});
document.getElementById('accionFilter').addEventListener('change', applyFilters);
document.getElementById('oxidoFilter').addEventListener('change', applyFilters);
document.getElementById('prevBtn').addEventListener('click', () => {
  if (page > 1) { page--; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
});
document.getElementById('nextBtn').addEventListener('click', () => {
  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
  if (page < totalPages) { page++; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
});

// ── Toast ─────────────────────────────────────────────────────
let toastTimer;
function toast(msg, type) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = 'toast show' + (type === 'err' ? ' err' : '');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { el.className = 'toast'; }, 3500);
}

// ── Boot ──────────────────────────────────────────────────────
loadData();
</script>
